// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String
  phone           String           @unique
  role            UserRole         @default(CLIENT)
  createdAt       DateTime         @default(now())
  providerProfile ProviderProfile?
}

model ProviderProfile {
  id                            String                  @id @default(cuid())
  userId                        String                  @unique
  county                        String
  serviceCategory               String
  policeClearanceNumber         String?
  idNumber                      String?
  certificationNumber           String?
  certificationIssuer           String?
  certificationName             String?
  credentialVerificationLevel   String?
  credentialVerificationMethod  String?
  credentialVerificationSource  String?
  credentialVerifiedAt          DateTime?
  credentialManualReference     String?
  verificationConsentAt         DateTime?
  identityVerificationLevel     String?
  identityVerificationMethod    String?
  identityVerificationSource    String?
  identityVerificationReference String?
  identityVerifiedAt            DateTime?
  identityVerifiedBy            String?
  policeVerificationLevel       String?
  policeVerificationMethod      String?
  policeVerificationSource      String?
  policeVerificationReference   String?
  policeVerifiedAt              DateTime?
  policeVerifiedBy              String?
  verificationStatus            VerificationStatus      @default(PENDING)
  adminNotes                    String?
  createdAt                     DateTime                @default(now())
  bookings                      Booking[]
  locationEvents                ProviderLocationEvent[]
  ratings                       Rating[]
  user                          User                    @relation(fields: [userId], references: [id])

  // Rating aggregation fields
  averageRating  Float?      @default(0)
  totalRatings   Int         @default(0)
  totalFiveStar  Int         @default(0)
  totalFourStar  Int         @default(0)
  totalThreeStar Int         @default(0)
  totalTwoStar   Int         @default(0)
  totalOneStar   Int         @default(0)
  rankingTier    RankingTier @default(NEW)
}

model Booking {
  id                         String                  @id @default(cuid())
  providerProfileId          String
  clientUserId               String?
  clientName                 String
  clientPhone                String
  county                     String
  scheduledDate              DateTime
  notes                      String?
  status                     BookingStatus           @default(REQUESTED)
  createdAt                  DateTime                @default(now())
  amount                     Float?
  paymentStatus              PaymentStatus           @default(PENDING)
  mpesaPhoneNumber           String?
  mpesaTransactionId         String?
  mpesaReceiptNumber         String?                 @unique
  mpesaCheckoutRequestId     String?                 @unique
  mpesaMerchantRequestId     String?
  mpesaAccountReference      String?                 @unique
  mpesaInitiationToken       String?                 @unique
  mpesaInitiatedAt           DateTime?
  paymentMethod              String?                 @default("MPESA")
  paymentCreatedAt           DateTime?
  developerFee               Float?                  @default(0)
  grossPlatformFee           Float?                  @default(0)
  paymentProcessingFee       Float?                  @default(0)
  providerAmount             Float?                  @default(0)
  commissionRate             Float?                  @default(0.12)
  serviceConfirmed           Boolean                 @default(false)
  serviceConfirmedAt         DateTime?
  clientConfirmed            Boolean                 @default(false)
  clientConfirmedAt          DateTime?
  suspiciousActivity         Boolean                 @default(false)
  securityFlag               String?
  escrowReleased             Boolean                 @default(false)
  ratingEligibleAt           DateTime?
  operationStartedAt         DateTime?
  operationEndedAt           DateTime?
  providerLocationConsentAt  DateTime?
  providerLocationLastSeenAt DateTime?
  providerLocationCapturedAt DateTime?
  providerLocationAccuracyM  Float?
  providerLocationRiskFlag   String?
  providerLocationGapCount   Int                     @default(0)
  providerProfile            ProviderProfile         @relation(fields: [providerProfileId], references: [id])
  locationEvents             ProviderLocationEvent[]
  rating                     Rating?

  @@index([clientUserId])
  @@index([providerProfileId, status])
}

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  AWAITING_CLIENT_CONFIRMATION
  REJECTED
  COMPLETED
  CANCELLED
}

model ProviderLocationEvent {
  id                   String            @id @default(cuid())
  bookingId            String
  providerProfileId    String
  capturedAt           DateTime
  receivedAt           DateTime          @default(now())
  accuracyM            Float
  encryptedCoordinates String
  eventType            LocationEventType @default(HEARTBEAT)
  riskFlags            String[]          @default([])
  booking              Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  providerProfile      ProviderProfile   @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([bookingId, receivedAt])
  @@index([providerProfileId, receivedAt])
}

enum LocationEventType {
  START
  HEARTBEAT
  REJECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Rating {
  id                    String          @id @default(cuid())
  bookingId             String          @unique
  providerProfileId     String
  clientPhone           String
  rating                Int // 1-5 stars
  comment               String?
  ratingLegitimacyScore Float           @default(0) // 0-1 score for legitimacy
  automatedFlags        String[]        @default([]) // Flags for suspicious patterns
  createdAt             DateTime        @default(now())
  ratingEligibleAt      DateTime // When rating became eligible (after dual confirmation)
  ratedAt               DateTime        @default(now())
  booking               Booking         @relation(fields: [bookingId], references: [id])
  providerProfile       ProviderProfile @relation(fields: [providerProfileId], references: [id])

  @@index([providerProfileId])
  @@index([bookingId])
}

enum RankingTier {
  NEW // 0-5 ratings
  EMERGING // 6-20 ratings
  ESTABLISHED // 21-50 ratings
  TOP_RATED // 51-100 ratings
  ELITE // 100+ ratings
}
